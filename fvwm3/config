Style "qterminal"		IconOverride, Icon iconbox/term.png
Style "*rxvt"			IconOverride, Icon iconbox/term.png
Style "st"				IconOverride, Icon iconbox/term.png
Style "Nvidia-settings" IconOverride, Icon iconbox/nvidia.png
Style "XOsview"         IconOverride, Icon iconbox/sysmon.png
Style "Blender"         IconOverride, Icon iconbox/Blender.png
Style "xfontsel"        IconOverride, Icon iconbox/xfontsel.png
Style "Audacious"       IconOverride, Icon iconbox/xmms.png
Style "Pavucontrol"     IconOverride, Icon iconbox/mixer.png
Style "Galculator"      IconOverride, Icon iconbox/Gcalctool.png
Style "Emacs"           IconOverride, Icon iconbox/edit.png
Style "Zutty"           IconOverride, Icon iconbox/term.png

# text editors
