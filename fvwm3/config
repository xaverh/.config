	Test (x xosview) \
		Launcher Xosview    launchers/xosview.png  "xosview"
	Test (x galculator) \
		Launcher calculator launchers/xcalc.png    "galculator"
	Test (x xnedit) \
		Launcher Xnedit      launchers/nedit.png    "xnedit"
	Test (x featherpad) \
		Launcher FeatherPad launchers/jot.png      "featherpad"

