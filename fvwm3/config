############################################################################
# Pager
#   FvwmPager can actually be configured to look a bit more like
#   4dwm's desk overview, but I like the default compact look better.
############################################################################
*FvwmPager: Geometry 383x120-0-36
*FvwmPagerLabel FvwmPager
*FvwmPagerSmallFont "-*-helvetica-medium-r-*-*-8-*-*-*-*-*-*-*"
*FvwmPager: LabelsAbove
*FvwmPager: NoMiniIcons
*FvwmPagerFont "-*-helvetica-bold-o-*-*-12-*-*-*-*-*-*-*"
*FvwmPager: Window3DBorders
*FvwmPager: WindowBorderWidth 2
*FvwmPager: Balloons All
*FvwmPager: BalloonYOffset +2
*FvwmPager: BalloonBorderWidth 1
*FvwmPager: UseSkipList
*FvwmPager: DeskHilight


############################################################################
# Mouse bindings
############################################################################

## The below line will disable the root menu completely
#Mouse 1	R   	A       Nop

## Enable root menu by left click
Mouse 1		R   	A       Menu RootMenu Nop

# Right click for window ops menu
# Middle click for window list 
Mouse 3		R    	A       Menu Window-Ops Nop
Mouse 2		R    	A      	WindowList NoIcons

# Left click is the Window-Ops2 menu, right is iconify, rightmost is maximize
Mouse 0		1       A       Menu Window-Ops2 Close
Mouse 0		2    	A     	Maximize
Mouse 0		4    	A     	Iconify

# Left click in Frame or Sides is a resize-or-raise
# and on Top does a move-or-raise
Mouse 1 	FS      A       Resize-or-Raise
Mouse 1		T       A       Maximize-or-Move

# Left click in an Icon is de-iconify
Mouse 1		I       A       Iconify off

# Middle click in Corners/Sides/Titlebar gets Ops Menu
Mouse 2 	FST     A       Menu Window-Ops2 Nop

# Right mouse click toggles raise-lower on anything
Mouse 3 	TSIF    A       RaiseLower

# Click-and-drag to move (LMB) and resize (RMB) with Super
# Clicking simply raises the windo
DestroyFunc DragNMoveWithRaise
AddToFunc DragNMoveWithRaise
+ H Raise
+ H Move
Mouse 1 W 4 DragNMoveWithRaise

DestroyFunc DragNMoveWithoutRaise
AddToFunc DragNMoveWithoutRaise
+ H Move
Mouse 1 W C4 DragNMoveWithoutRaise

DestroyFunc DragNSize
AddToFunc DragNSize H Resize
Mouse 3 W 4 DragNSize

# Thumbnail overrides for iconify
Mouse ("Chromium") 1		I       A       Iconify off
Mouse ("Chromium") 0		4    	A     	Iconify


############################################################################
# Keyboard bindings
############################################################################

# Don't refuse if I accidentally have NumLock and ScrollLock on!
IgnoreModifiers L25

# Move between pages (Super+{up, down, left, right})
Key Left	A	4	Scroll -100 0
Key Right	A	4	Scroll +100  +0
Key Up		A	4	Scroll +0 -100
Key Down	A	4	Scroll +0 +100

# Move between desktops (Ctrl+Super+{up, down})
Key Left		A	C4	GotoDesk -1 0 2
Key Right	A	C4	GotoDesk  1 0 2

## Fast Alt-Tab
# Key Tab A 4 WindowList Root c c CurrentDesk, NoGeometry, CurrentAtEnd, IconifiedAtEnd, NoIcons
# Key Tab A 4 WindowList Root c c NoDeskSort, SelectOnRelease Super_L, SelectOnRelease Alt_L, CurrentAtEnd, IconifiedAtEnd
Key Tab A M WindowList Root c c NoDeskSort, SelectOnRelease Alt_L, CurrentAtEnd, IconifiedAtEnd

# Fast page switch (Super+{1..6})
Key	1	A	S4	GotoPage 0 0
Key	2	A	S4	GotoPage 1 0
Key	3	A	S4	GotoPage 0 1
Key	4	A	S4	GotoPage 1 1
Key	5	A	S4	GotoPage 0 2
Key	6	A	S4	GotoPage 1 2

# Fast desktop switch (Shift+Super+{1..9)
Key	1	A	4	GotoDesk 0 0
Key	2	A	4	GotoDesk 0 1
Key	3	A	4	GotoDesk 0 2
Key	4	A	4	GotoDesk 0 3
Key	5	A	4	GotoDesk 0 4
Key	6	A	4	GotoDesk 0 5
Key	7	A	4	GotoDesk 0 6
Key	8	A	4	GotoDesk 0 7
Key	9	A	4	GotoDesk 0 8

# Close a window (Super+Q)
Key Q	A	4 Close

# Iconify a window (Super M)
Key M	W	4 Iconify
Key M	I	4 Iconify Off

# Thumbnail overrides for iconify
Key ("Chromium") M	W	4 Iconify
Key ("Chromium") M	I	4 Iconify off

Key h A S4 AnimatedMove w-10 keep ewmhiwa
Key j A S4 AnimatedMove keep w10 ewmhiwa
Key k A S4 AnimatedMove keep w-10 ewmhiwa
Key l A S4 AnimatedMove w10 keep ewmhiwa

DestroyFunc ScrollAndRefocus
AddToFunc ScrollAndRefocus
+ I Scroll $0 $1
+ I All (CurrentPage, Focused, !Iconic) FlipFocus NoWarp
+ I TestRc (NoMatch) Prev (CurrentPage, AcceptsFocus, !Iconic) FlipFocus NoWarp

Key h A 4 ScrollAndRefocus -25 0
Key j A 4 ScrollAndRefocus +0 +50
Key k A 4 ScrollAndRefocus +0 -50
Key l A 4 ScrollAndRefocus +25 +0

