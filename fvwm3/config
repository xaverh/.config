# TODO: convert to infostore
SetEnv	FVWM_TERMINAL          "zutty"
SetEnv	FVWM_TERMINAL_EXEC_CMD "-c"
SetEnv FVWM_DESKTOP_UPPERBOUND 2

EwmhNumberOfDesktops 3 0
DesktopName 0 🌐
DesktopName 1 ☕
DesktopName 2 👾
DesktopName 3 🧠
DesktopName 4 🥑
DesktopName 5 🍓
DesktopName 6 🎲
DesktopName 7 🎰
DesktopName 8 🎱
DesktopName 9 🏜️
DesktopName 10 🦄
DesktopSize 2x2

ClickTime 250
MoveThreshold 3
EdgeScroll 10 10
EdgeResistance 2
EdgeThickness 2
OpaqueMoveSize unlimited

Style * ResizeOpaque, \
	SnapAttraction 5 SameType ScreenAll, \
	SnapGrid, \
	DecorateTransient, \
	StackTransientParent, \
	WindowShadeScrolls, \
	WindowShadeSteps 10, \
	!Icon, \
	EdgeMoveResistance 2, \
	EdgeMoveDelay 128, \
	EdgeResizeDelay -1, \
	ClickToFocus, \
	FPFocusByFunctionWarpPointer, \
	!FPGrabFocusTransient, \
	FPReleaseFocusTransient, \
        Colorset 1, \
        HilightColorset 2, \
	MWMButtons, \
	FvwmBorder, \
	FirmBorder, \
	HandleWidth 1, \
	MinOverlapPercentPlacement
	# !UsePPosition

# Click/release must occur in <n milliseconds to be a "click"
ClickTime 10

# Always use solid window moving
OpaqueMoveSize -1

# Window placement
# Style "*" DumbPlacement

# border width 7 seems to be a good approximation of 4dwm,
# althought fvwm doesn't do the nice 4dwm dither of the 3d bevels.
Style "*" BorderWidth 7, HandleWidth 7

# FVWM
Style *             Title, Handles, !MWMFunctions, MWMButtons, NoDecorHint, Lenience, DecorateTransient
Style "Fvwm*"		NoTitle, Sticky, WindowListSkip, NoHandles, BorderWidth 7
Style "FvwmPager"             Title, Handles, !MWMFunctions, NoDecorHint, Lenience

# various apps
Style "xload"		NoTitle, Sticky, WindowListSkip, NoHandles, FPLenient, BorderWidth 7
Style "*lock"		NoTitle, Sticky, WindowListSkip, NoHandles, BorderWidth 7
Style "stalonetray"		NoTitle, Sticky, WindowListSkip, NoHandles, BorderWidth 7
Style "audacious"		NoTitle, Sticky, NoHandles, BorderWidth 0
Style "Chromium"        Title, Handles, !MWMFunctions, NoDecorHint
Style "Wine"         Title, Handles, !MWMFunctions, NoDecorHint
Style "Panther"         NoTitle, Sticky, NoHandles, BorderWidth 7, PositionPlacement center, NoPPosition, NoUSPosition
Style "Onboard" NeverFocus

# SGI-Style "flat" window buttons, close/minimize/maximize
# These are ripped from somewhere on the net, I wish I remember from where and could give credit.
ButtonStyle 2 Vector 9 0+5px100-6p@3 100-7px100-6p@3 100-7px-0+4p@3 0+5px0+4p@3 0+5px100-5p@3 0+7px100-5p@2 0+8px100-5p@3 100-6px100-5p@3 100-6px-0+6p@3
ButtonStyle 4 Vector 9 50-2px50+1p@3 50+2px50+1p@3 50+2px50-3p@3 50-2px50-3p@3 50-2px50+2p@3 50-0px50+2p@2 50-0px50+2p@3 50+3px50+2p@3 50+3px50-1p@3
ButtonStyle 1 Vector 9 0+4px50+1p@3 100-6px50+1p@3 100-6px50-2p@3 0+4px50-2p@3 0+4px50+2@3 0+5px50+2p@2 0+6px50+2p@2 100-5px50+2p@3 100-5px50@3

WindowFont              "-*-helvetica-bold-o-*-*-14-*-*-*-*-*-*"
TitleStyle LeftJustified
TitleStyle Height 23

# Generic menu style
MenuStyle Mwm
MenuStyle "*" Font -*-helvetica-bold-o-*-*-12-*-*-*-*-*-*

############################################################################
# Window handling functions
############################################################################

AddToFunc Move-or-Raise		"I" Raise
+				"M" Move
+				"D" Lower

AddToFunc Move-or-Raise2        "M" Raise
+				"M" Move
+				"D" Lower

AddToFunc Resize-or-Raise       "I" Raise
+                               "M" Resize
+                               "D" Lower

AddToFunc Resize-or-Raise2      "M" Raise
+                               "M" Resize
+                               "D" Lower

AddToFunc PrintFunction         "I" Raise
+                               "I" Exec xdpr -id $w

AddToFunc Iconify-and-Raise     "I" Iconify
+                               "I" Raise

AddToFunc Maximize-or-Move
 + D Maximize
 + I Raise
 + C Focus
 + M Move


############################################################################
# Window operations menus
############################################################################

# Menu for window operations
AddToMenu Window-Ops
	+ "  Select a window to...  "    Title
	+ "Move "          Move-or-Raise2
	+ "Resize "        Resize-or-Raise2
	+ "Raise "         Raise
	+ "Lower "         Lower
	+ "(De)Iconify "   Iconify
	+ "(Un)Stick "     Stick
	+ "(Un)Maximize "  Maximize
	+ ""              Nop
	+ "Delete "        Delete
	+ "Close "         Close
	+ "Destroy "       Destroy
	+ ""              Nop
	+ "Identify"            Module FvwmIdent
	+ "Refresh Screen " Refresh

# Menu for top left hand ("close") button on windows
AddToMenu Window-Ops2
	+			"Raise/Lower "   RaiseLower
	+                       "Iconify "       Iconify
	+                       "(Un)Stick "     Stick
	+                       ""              Nop
	+                       "Delete "        Delete
	+                       "Close "         Close
	+                       "Destroy "       Destroy

# add more apps with the syntax `+ "Label" <command> &`...

#------- "System" menu ------------#
AddToMenu SysMenu
	+	"File Manager"	Exec exec exo-open --launch FileManager
	Test (x pavucontrol)  +	"PulseAudio Control Panel" Exec exec pavucontrol
	Test (x alsamixer)    +	"ALSA Mixer" Exec exec $FVWM_TERMINAL $FVWM_TERMINAL_EXEC_CMD alsamixer
	+	"" 			Nop
	+	"Restart FVWM"	Restart fvwm2
	+ 	"Exit"		Popup ExitMenu

#------- "Exit" menu ------------#
# suspend assumes you're using systemd
AddToMenu ExitMenu
	+ 	"Log Out"		Popup QuitMenu
	+	"Suspend"	Exec systemctl suspend
	+	"Shut Down"	Exec poweroff
	+	"Reboot"	Exec reboot

#------- Confirm quitting X ------------#
AddToMenu QuitMenu "Really quit?" Title
	+   "Yeah" Quit
	+   "No"  Nop

#------- "Internet" menu ------------#
AddToMenu SurfMenu
	+	"Web Browser"	Exec exec firefox

## Various utilities and applications menu
AddToMenu UtilsMenu
	Test (x galculator)	    +   "Calculator"            exec galculator &
	Test (x qalculate-gtk)	+   "Scientific Calculator" exec qalculate-gtk &

## Graphics programs menu
AddToMenu GfxMenu
	Test (x gimp) +	"GIMP"		exec gimp &

## Music software menu
AddToMenu MusicMenu
	Test (x audacious)	+	"Audacious "			exec audacious &

AddToMenu RootMenu
	+ "Workspace Menu "  Title
	+ "Terminal " exec $FVWM_TERMINAL &
	+ "" 			Nop
	+ "Internet "	Popup SurfMenu
	+ "Graphics "	Popup GfxMenu
	+ "Music "	Popup MusicMenu
	+ "Utils "	Popup UtilsMenu
	+ "System "	Popup SysMenu
	Test (x panther_launcher) + "All Apps " exec panther_launcher &

Style Toolchest Title, !Handles, BorderWidth 2, !Button 1, !Button 2, !Button 4, !Closable, Sticky, !StickyStippledTitle, WindowListSkip, !Closable
Style FvwmButtons Title, !Handles, !Button 1, !Button 2, !Button 4, Sticky, !StickyStippledTitle, WindowListSkip, !Closable
*Toolchest: Columns 1
*Toolchest: Rows 6
*Toolchest: BoxSize smart
*Toolchest: Padding 11 0
*Toolchest: Frame 1
*Toolchest: Font "-*-helvetica-bold-*-*-*-14-*-*-*-*-*-*-*"
*Toolchest: ButtonGeometry 120x26+5+5
*Toolchest: (Right, Title (Side, Left) "System ", Icon toolIcon.xpm, Action (Mouse 1) \
    	`Menu SysMenu rectangle $widthx$height+$left+$top  +$widthp-5p +1p`)
*Toolchest: (Right, Icon toolIcon.xpm, Title (Side, Left) "Graphics ", Action (Mouse 1) \
	`Menu GfxMenu rectangle $widthx$height+$left+$top +$widthp-5p +1p`)
*Toolchest: (Right, Icon toolIcon.xpm, Title (Side, Left) "Utilities ", Action (Mouse 1) \
    	`Menu UtilsMenu rectangle $widthx$height+$left+$top  +$widthp-5p +1p`)
*Toolchest: (Right, Icon toolIcon.xpm, Title (Side, Left) "Internet ", Action (Mouse 1) \
    	`Menu SurfMenu rectangle $widthx$height+$left+$top  +$widthp-5p +1p`)
*Toolchest: (Right, Title (Side, Left) "Music ", Icon toolIcon.xpm, Action (Mouse 1) \
    	`Menu MusicMenu rectangle $widthx$height+$left+$top  +$widthp-5p +1p`)
*Toolchest: (Right, Title (Side, Left) "Terminal ", Action (Mouse 1) \
    	`exec $FVWM_TERMINAL &`)


IconFont              "-*-helvetica-medium-r-*-*-14-*-*-*-*-*-*-*"

# icon box
# XXX: you may need to adjust the size here
Style * IconBox 1680x305+135+6, IconGrid 1 1, IconFill Left Top
Style * IconSize 90 70 -1 -1
Style * IconBackgroundRelief 2
Style * IconBackgroundPadding 2
Style * IconBackgroundRelief 2

## Set path to icons and pixmaps
